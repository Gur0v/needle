{
  "manifest_version": 3,
  "name": "Needle",
  "version": "0.1.0",
  "description": "A lightweight Last.fm scrobbler for YouTube Music.",
  "browser_specific_settings": {
    "gecko": {
      "id": "needle@example.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://music.youtube.com/*", "https://ws.audioscrobbler.com/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["content.js"] },
    { "matches": ["https://music.youtube.com/*"], "js": ["page-bridge.js"], "world": "MAIN" }
  ],
  "action": { "default_title": "Needle", "default_popup": "popup.html" }
}

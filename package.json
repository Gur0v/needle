{
  "name": "needle",
  "version": "0.1.1",
  "description": "Lightweight Last.fm scrobbler for Firefox",
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "dev": "web-ext run --source-dir dist --firefox-profile .firefox-profile --profile-create-if-missing --keep-profile-changes"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "blueimp-md5": "^2.19.0"
  },
  "devDependencies": {
    "@types/blueimp-md5": "^2.18.2",
    "@types/firefox-webext-browser": "^143.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0"
  },
  "private": true
}
